{
  "name": "@axcut/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspace @axcut/schema && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @axcut/schema && tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace @axcut/schema && tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@axcut/schema": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/langgraph": "^1.2.7",
    "@langchain/openai": "^1.4.2",
    "@yagr/deepagent-bootstrap": "^0.1.2",
    "@yagr/provider-runtime": "^0.1.2",
    "@yagr/runtime-events": "^0.1.3",
    "@yagr/session-service": "^0.1.2",
    "@yagr/stream-adapter": "^0.1.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "langchain": "^1.2.39",
    "langsmith": "^0.3.68",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2"
  }
}
