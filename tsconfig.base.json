{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "paths": {
      "@axcut/schema": [
        "packages/axcut-schema/dist/index.d.ts"
      ]
    },
    "types": [
      "node"
    ]
  }
}
