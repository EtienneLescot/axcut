{
  "name": "axcut",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:docker": "concurrently -n server,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:web -- --host 0.0.0.0\"",
    "dev:server": "npm run dev --workspace @axcut/server",
    "dev:web": "npm run dev --workspace @axcut/web",
    "assets:generate": "node scripts/generate-assets.mjs",
    "clean:processes": "node scripts/clean-processes.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
